# 复制成 .env 并填入真实值；.env 已在 .gitignore 里，不会被提交。
# 不带 .env 也能跑——config.py 里每项都有默认值，只有密钥必须自己给。

# ── LLM（OpenAI 兼容接口）─────────────────────────────
KB_LLM_API_KEY=
KB_LLM_BASE_URL=https://api.deepseek.com
KB_LLM_MODEL=deepseek-chat

# ── MySQL 主存 ────────────────────────────────────────
KB_MYSQL_HOST=127.0.0.1
KB_MYSQL_PORT=3306
KB_MYSQL_USER=root
KB_MYSQL_PASSWORD=
KB_MYSQL_DATABASE=deal_files

# ── Redis 向量索引 ────────────────────────────────────
KB_REDIS_URL=redis://127.0.0.1:6379

# ── 嵌入模型（Ollama）─────────────────────────────────
KB_EMBEDDING_MODEL=bge-m3:latest
KB_EMBEDDING_BASE_URL=http://localhost:11434

# ── MCP 服务 ──────────────────────────────────────────
KB_MCP_URL=http://127.0.0.1:8889/mcp

# ── WebAPI 服务 ───────────────────────────────────────
KB_WEBAPI_HOST=0.0.0.0
KB_WEBAPI_PORT=8000
